{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-storytelling:story-extraction:draft:v1.1:model-schema:v1",
  "title": "STORY_EXTRACTION_DRAFT_V1_1_MODEL_SCHEMA_V1",
  "description": "Self-contained model-facing form of STORY_EXTRACTION_DRAFT_V1_1. Every definition is local; no reference leaves this document. Materialized mechanically from the canonical Draft V1 and Draft V1.1 schemas without changing any rule.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draft_version",
    "evidence",
    "mentions",
    "entities",
    "events",
    "anchors",
    "propositions",
    "assertions"
  ],
  "properties": {
    "draft_version": {
      "const": "STORY_EXTRACTION_DRAFT_V1_1"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Evidence"
      }
    },
    "mentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Mention"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entity"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Event"
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TemporalAnchor"
      }
    },
    "propositions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Proposition"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Assertion"
      }
    }
  },
  "$defs": {
    "Mention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "passage_handle",
        "quote",
        "role"
      ],
      "properties": {
        "handle": {
          "type": "string",
          "pattern": "^M[1-9][0-9]*$"
        },
        "passage_handle": {
          "type": "string",
          "pattern": "^P[1-9][0-9]*$"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "$ref": "#/$defs/EvidenceRole"
        },
        "surface_form": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "Handle": {
      "type": "string",
      "pattern": "^(P[1-9][0-9]*|EV[1-9][0-9]*|M[1-9][0-9]*|E_NEW_[1-9][0-9]*|EVT[1-9][0-9]*|T[1-9][0-9]*|PROP[1-9][0-9]*|A[1-9][0-9]*|(?:E|EVT|T|PROP|M|EV|A)_EXISTING_[1-9][0-9]*)$"
    },
    "EvidenceRole": {
      "enum": [
        "DEPICTION",
        "RETROSPECTIVE",
        "IN_WORLD_REPORT",
        "NARRATION_SUMMARY",
        "PARATEXT"
      ]
    },
    "EntityKind": {
      "enum": [
        "CHARACTER",
        "LOCATION",
        "OBJECT",
        "GROUP",
        "OTHER"
      ]
    },
    "EditorialLabel": {
      "type": "string",
      "maxLength": 200
    },
    "Argument": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "handle"
          ],
          "properties": {
            "kind": {
              "enum": [
                "ENTITY",
                "EVENT",
                "ANCHOR",
                "MENTION",
                "PROPOSITION"
              ]
            },
            "handle": {
              "$ref": "#/$defs/Handle"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value_type",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "LITERAL"
            },
            "value_type": {
              "enum": [
                "STRING",
                "NUMBER",
                "BOOLEAN",
                "DATE"
              ]
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "vocabulary",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "TOKEN"
            },
            "vocabulary": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "EvidenceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "evidence_handles"
      ],
      "properties": {
        "label": {
          "enum": [
            "SUFFICIENT",
            "CORROBORATING",
            "PARTIAL"
          ]
        },
        "evidence_handles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Handle"
          }
        }
      }
    },
    "Derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "premise_handles"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "premise_handles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Handle"
          }
        }
      }
    },
    "Support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_sets",
        "derivations"
      ],
      "properties": {
        "evidence_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceSet"
          }
        },
        "derivations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Derivation"
          }
        }
      }
    },
    "Bound": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "OPEN"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "anchor_handle"
          ],
          "properties": {
            "kind": {
              "const": "ANCHOR"
            },
            "anchor_handle": {
              "$ref": "#/$defs/Handle"
            },
            "support": {
              "$ref": "#/$defs/Support"
            }
          }
        }
      ]
    },
    "ValidityInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/Bound"
        },
        "end": {
          "$ref": "#/$defs/Bound"
        }
      }
    },
    "Entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "kind"
      ],
      "properties": {
        "handle": {
          "type": "string",
          "pattern": "^E_NEW_[1-9][0-9]*$"
        },
        "kind": {
          "$ref": "#/$defs/EntityKind"
        },
        "placeholder": {
          "type": "boolean"
        },
        "editorial_label": {
          "$ref": "#/$defs/EditorialLabel"
        }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "event_kind",
        "anchor_handle"
      ],
      "properties": {
        "handle": {
          "type": "string",
          "pattern": "^EVT[1-9][0-9]*$"
        },
        "event_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "anchor_handle": {
          "$ref": "#/$defs/Handle"
        },
        "editorial_label": {
          "$ref": "#/$defs/EditorialLabel"
        }
      }
    },
    "TemporalAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "anchor_kind"
      ],
      "properties": {
        "handle": {
          "type": "string",
          "pattern": "^T[1-9][0-9]*$"
        },
        "anchor_kind": {
          "enum": [
            "EVENT_TIME",
            "NAMED_TIME"
          ]
        },
        "event_handle": {
          "$ref": "#/$defs/Handle"
        },
        "editorial_label": {
          "$ref": "#/$defs/EditorialLabel"
        }
      },
      "if": {
        "properties": {
          "anchor_kind": {
            "const": "EVENT_TIME"
          }
        }
      },
      "then": {
        "required": [
          "event_handle"
        ]
      },
      "else": {
        "not": {
          "required": [
            "event_handle"
          ]
        }
      }
    },
    "Proposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handle",
            "predicate",
            "args"
          ],
          "properties": {
            "handle": {
              "type": "string",
              "pattern": "^PROP[1-9][0-9]*$"
            },
            "predicate": {
              "type": "string",
              "pattern": "^[A-Z][A-Za-z0-9]*$"
            },
            "args": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "#/$defs/Argument"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handle",
            "placeholder"
          ],
          "properties": {
            "handle": {
              "type": "string",
              "pattern": "^PROP[1-9][0-9]*$"
            },
            "placeholder": {
              "const": true
            },
            "editorial_label": {
              "$ref": "#/$defs/EditorialLabel"
            }
          }
        }
      ]
    },
    "Assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "proposition_handle",
        "polarity",
        "epistemic_status",
        "support"
      ],
      "properties": {
        "handle": {
          "type": "string",
          "pattern": "^A[1-9][0-9]*$"
        },
        "proposition_handle": {
          "$ref": "#/$defs/Handle"
        },
        "polarity": {
          "enum": [
            "AFFIRMED",
            "NEGATED",
            "OPEN"
          ]
        },
        "epistemic_status": {
          "enum": [
            "EXPLICIT",
            "ENTAILED",
            "SUGGESTED"
          ]
        },
        "validity": {
          "$ref": "#/$defs/ValidityInterval"
        },
        "support": {
          "$ref": "#/$defs/Support"
        },
        "textual_ambiguity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alternative_proposition_handles"
          ],
          "properties": {
            "alternative_proposition_handles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/Handle"
              }
            }
          }
        }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "passage_handle",
        "quote",
        "role"
      ],
      "properties": {
        "handle": {
          "type": "string",
          "pattern": "^EV[1-9][0-9]*$"
        },
        "passage_handle": {
          "type": "string",
          "pattern": "^P[1-9][0-9]*$"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "$ref": "#/$defs/EvidenceRole"
        }
      }
    }
  }
}
