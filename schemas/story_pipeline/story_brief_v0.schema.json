{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story_pipeline/story_brief_v0",
  "title": "Chapter Story Brief v0",
  "type": "object",
  "required": [
    "chapter_order",
    "chapter_summary",
    "characters",
    "relationships",
    "events",
    "unknowns",
    "forbidden_inferences",
    "ending_state",
    "closing_hook"
  ],
  "additionalProperties": false,
  "properties": {
    "chapter_order": {
      "type": "integer",
      "minimum": 1
    },
    "chapter_summary": {
      "type": "string",
      "minLength": 1
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "romanized_name",
          "aliases",
          "facts"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CH\\d+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "romanized_name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "evidence",
                "quote",
                "epistemic"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+$"
                  },
                  "description": "Source passage ids such as \"1.12\" that establish the item."
                },
                "quote": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 80,
                  "description": "Short verbatim excerpt (<= 60 characters) copied exactly from one of the cited passages, in the source language."
                },
                "epistemic": {
                  "enum": [
                    "EXPLICIT",
                    "REPORTED",
                    "APPEARANCE",
                    "SPECULATION",
                    "FIGURATIVE"
                  ],
                  "description": "How the source presents this: stated as fact, reported/rumoured, only apparent, guessed by narrator or character, or figurative. Not EXPLICIT if any passage it relies on hedges it."
                }
              }
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "between",
          "state",
          "evidence",
          "quote",
          "epistemic"
        ],
        "additionalProperties": false,
        "properties": {
          "between": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^CH\\d+$"
            }
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+$"
            },
            "description": "Source passage ids such as \"1.12\" that establish the item."
          },
          "quote": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "description": "Short verbatim excerpt (<= 60 characters) copied exactly from one of the cited passages, in the source language."
          },
          "epistemic": {
            "enum": [
              "EXPLICIT",
              "REPORTED",
              "APPEARANCE",
              "SPECULATION",
              "FIGURATIVE"
            ],
            "description": "How the source presents this: stated as fact, reported/rumoured, only apparent, guessed by narrator or character, or figurative. Not EXPLICIT if any passage it relies on hedges it."
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "participants",
          "location",
          "importance",
          "motivation",
          "consequence",
          "evidence",
          "quote",
          "epistemic"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E\\d+$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CH\\d+$"
            }
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "importance": {
            "enum": [
              "CORE",
              "SUPPORTING",
              "MINOR"
            ]
          },
          "motivation": {
            "type": "object",
            "required": [
              "text",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "EXPLICIT",
                  "SUPPORTED_INFERENCE",
                  "REPORTED",
                  "UNKNOWN"
                ]
              }
            }
          },
          "consequence": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+$"
            },
            "description": "Source passage ids such as \"1.12\" that establish the item."
          },
          "quote": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "description": "Short verbatim excerpt (<= 60 characters) copied exactly from one of the cited passages, in the source language."
          },
          "epistemic": {
            "enum": [
              "EXPLICIT",
              "REPORTED",
              "APPEARANCE",
              "SPECULATION",
              "FIGURATIVE"
            ],
            "description": "How the source presents this: stated as fact, reported/rumoured, only apparent, guessed by narrator or character, or figurative. Not EXPLICIT if any passage it relies on hedges it."
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_inferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ending_state": {
      "type": "string",
      "minLength": 1
    },
    "closing_hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "quote",
        "evidence"
      ],
      "description": "How the chapter's last lines point forward (a hint, a reversal, 'or so he thought'). All null/empty when the chapter ends flat.",
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ],
          "description": "What the closing device says or implies, without guessing what comes next."
        },
        "quote": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80,
          "description": "Verbatim excerpt of the closing device."
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$"
          }
        }
      }
    },
    "full_target_units_estimate": {
      "type": "integer",
      "minimum": 1,
      "description": "Optional estimate of the unabridged chapter length in the requested output language."
    }
  }
}
