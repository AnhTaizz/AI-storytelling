{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story_pipeline/script_v0",
  "title": "Script v0",
  "type": "object",
  "required": [
    "title_idea",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "title_idea": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "beat_id",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "beat_id": {
            "type": "string",
            "pattern": "^B\\d+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
