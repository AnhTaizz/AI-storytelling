# Copy to .env and add more numbered keys as needed; that is all basic use needs.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# --- Advanced (all optional) ---
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash
# GEMINI_FREE_MODELS=gemini-3.8-flash,gemini-3.6-flash
# The free model override can narrow the code list only.
# GEMINI_PROJECT_LABEL_<n>=
# GEMINI_PROJECT_BILLING_<n>=
# GEMINI_KEYS_FREE_TIER_CONFIRMED=true
# GEMINI_MAX_RATE_LIMIT_HOPS=3
# LLM_QUOTA_STATE_PATH=.local/llm_quota_state.sqlite3
# LLM_FREE_ONLY=true
# LLM_ALLOW_PAID=false
# MAX_PAID_SPEND_USD=0
# Zero spend is an application limit only.

# Optional conservative local research limits. These are not claims about the
# quota assigned by Google to any account, project, tier, or model.
GEMINI_DEFAULT_RPM=
GEMINI_DEFAULT_TPM=

# Optional private JSON file with project/model overrides. Do not commit it.
# GEMINI_PROJECT_MODEL_LIMITS_FILE=

# --- Groq Free plan (optional second provider) ---
GROQ_API_KEY_1=

# Advanced settings. Keys from one Groq account share one organization quota.
# More keys from the same organization add no quota.
# GROQ_API_KEY_2=
# Set an organization label only for a different organization you control.
# GROQ_ORG_LABEL_<n>=
# GROQ_KEYS_FREE_PLAN_CONFIRMED=true
# GROQ_ORG_PLAN_<n>=FREE_PLAN_CONFIRMED
# UNVERIFIED and PAID_PLAN exclude keys. Plan declarations must agree within each organization.
# GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
# GROQ_FREE_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# The free model override can only narrow the reviewed list.
# GROQ_MAX_RATE_LIMIT_HOPS=3

# --- OpenRouter free models (optional third provider) ---
OPENROUTER_API_KEY_1=

# Advanced settings. Unlabeled keys share the openrouter_account scope.
# Extra keys or accounts do not raise the free-model limits.
# OPENROUTER_API_KEY_2=
# Set an account label only for a key from a different account you control.
# OPENROUTER_ACCOUNT_LABEL_<n>=
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_FREE_MODELS=openrouter/free
# OPENROUTER_DATA_COLLECTION=deny
# Leave data collection unset to use account privacy settings.
# OPENROUTER_MAX_RATE_LIMIT_HOPS=2

# --- Cloudflare Workers Free (optional fourth provider) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# The unnumbered pair uses slot 1. The _1 credential names also work.
# Add both settings for each additional slot (_2, _3, ...). Tokens for one account share a budget.
# CLOUDFLARE_ACCOUNT_ID_2=
# CLOUDFLARE_API_TOKEN_2=
# CLOUDFLARE_KEYS_FREE_PLAN_CONFIRMED=true
# CLOUDFLARE_PLAN_1=WORKERS_FREE_CONFIRMED
# CLOUDFLARE_PLAN_<n>=WORKERS_FREE_CONFIRMED
# WORKERS_PAID and UNVERIFIED exclude slots. Declarations must agree within each account.
# CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b,@cf/qwen/qwen3-30b-a3b-fp8
# CLOUDFLARE_FREE_MODELS=@cf/openai/gpt-oss-120b,@cf/qwen/qwen3-30b-a3b-fp8
# CLOUDFLARE_DAILY_NEURON_BUDGET=9000
# CLOUDFLARE_MAX_RATE_LIMIT_HOPS=2
