# Copy locally to .env. Never commit credentials or real project identifiers.

GEMINI_API_KEY_1=
GEMINI_PROJECT_LABEL_1=

GEMINI_API_KEY_2=
GEMINI_PROJECT_LABEL_2=

GEMINI_API_KEY_3=
GEMINI_PROJECT_LABEL_3=

# Continue numbered API-key/project-label pairs as needed; the runtime supports
# arbitrary positive slot numbers. Labels are local aliases: keys from the same
# Google project must use the same label, and keys from different projects must
# use different labels. Leave a label blank when independence is unknown.

# Optional user-selected model. Keep blank unless intentionally configured.
GEMINI_MODEL=

# Optional conservative local research limits. These are not claims about the
# quota assigned by Google to any account, project, tier, or model.
GEMINI_DEFAULT_RPM=
GEMINI_DEFAULT_TPM=

# Optional private JSON file with project/model overrides. Do not commit it.
# GEMINI_PROJECT_MODEL_LIMITS_FILE=
