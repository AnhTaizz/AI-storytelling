# Copy locally to .env. Use local aliases and keep real credentials private.
GEMINI_API_KEY_1=
GEMINI_PROJECT_LABEL_1=
GEMINI_PROJECT_BILLING_1=
GEMINI_API_KEY_2=
GEMINI_PROJECT_LABEL_2=
GEMINI_PROJECT_BILLING_2=
GEMINI_API_KEY_3=
GEMINI_PROJECT_LABEL_3=
GEMINI_MODEL=
GEMINI_FREE_MODELS=

# Required for every example. Include every model in the selected fallback chain.
# GEMINI_MODEL=<primary-model>,<fallback-model>
# GEMINI_FREE_MODELS=<primary-model>,<fallback-model>
# LLM_FREE_ONLY=true
# LLM_ALLOW_PAID=false
# MAX_PAID_SPEND_USD=0
# This is an application limit only. The owner checks actual billing.

# 1. One key, one verified project. The label is optional.
# GEMINI_API_KEY_1=<key-1>
# GEMINI_KEYS_FREE_TIER_CONFIRMED=true

# 2. Two keys in the same verified project. Both share quota and billing status.
# GEMINI_API_KEY_1=<key-1>
# GEMINI_PROJECT_LABEL_1=project-a
# GEMINI_API_KEY_2=<key-2>
# GEMINI_PROJECT_LABEL_2=project-a
# GEMINI_PROJECT_BILLING_1=FREE_TIER_CONFIRMED

# 3. Two independently verified projects. Confirm each project separately.
# GEMINI_API_KEY_1=<key-1>
# GEMINI_PROJECT_LABEL_1=project-a
# GEMINI_PROJECT_BILLING_1=FREE_TIER_CONFIRMED
# GEMINI_API_KEY_2=<key-2>
# GEMINI_PROJECT_LABEL_2=project-b
# GEMINI_PROJECT_BILLING_2=FREE_TIER_CONFIRMED

# GEMINI_KEYS_FREE_TIER_CONFIRMED=true applies to exactly one project scope.
# Explicit UNVERIFIED or BILLING_ENABLED excludes the entire project.
# Repeated keys count once. Continue numbering with positive slot numbers.
# Optional local SQLite file (default .local/llm_quota_state.sqlite3).
LLM_QUOTA_STATE_PATH=

# Optional conservative local research limits. These are not claims about the
# quota assigned by Google to any account, project, tier, or model.
GEMINI_DEFAULT_RPM=
GEMINI_DEFAULT_TPM=

# Optional private JSON file with project/model overrides. Do not commit it.
# GEMINI_PROJECT_MODEL_LIMITS_FILE=
