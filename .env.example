# Copy locally to .env. Never commit credentials or real project identifiers.

GEMINI_API_KEY_1=
GEMINI_PROJECT_LABEL_1=

GEMINI_API_KEY_2=
GEMINI_PROJECT_LABEL_2=

GEMINI_API_KEY_3=
GEMINI_PROJECT_LABEL_3=

# Continue numbered keys as needed; the runtime supports arbitrary positive slot
# numbers. Labels are optional local aliases. A blank label makes the key its own
# quota scope; give keys of one Google project the same label to share a cooldown.
# Repeated keys are used once.

# Optional user-selected model. Keep blank unless intentionally configured.
GEMINI_MODEL=

# Free-only policy. Set to true only after checking that no project of these keys
# has billing enabled (AI Studio shows the free tier). Until then no request is sent.
GEMINI_KEYS_FREE_TIER_CONFIRMED=
# Optional per-key override: GEMINI_PROJECT_BILLING_<n>=FREE_TIER_CONFIRMED,
# UNVERIFIED or BILLING_ENABLED (a BILLING_ENABLED key is never used).
# Optional extra limit: comma-separated models the pipeline may use.
GEMINI_FREE_MODELS=
LLM_FREE_ONLY=true
LLM_ALLOW_PAID=false
# Application limit only, not a billing guarantee.
MAX_PAID_SPEND_USD=0
# Optional local SQLite file (default .local/llm_quota_state.sqlite3).
LLM_QUOTA_STATE_PATH=

# Optional conservative local research limits. These are not claims about the
# quota assigned by Google to any account, project, tier, or model.
GEMINI_DEFAULT_RPM=
GEMINI_DEFAULT_TPM=

# Optional private JSON file with project/model overrides. Do not commit it.
# GEMINI_PROJECT_MODEL_LIMITS_FILE=
